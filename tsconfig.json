{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hyoro/core": ["packages/core/src/index.ts"],
      "@hyoro/platform": ["packages/platform/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "games/*/src", "games/*/tests", "games/*/*.ts", "scripts"]
}
